# Telegram bot token
TELEGRAM_BOT_TOKEN=123456789:ABCDEF

# SQLAlchemy database URL (MySQL via PyMySQL)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/training_diary

# Public URL where the mini app is hosted (optional)
WEBAPP_BASE_URL=https://your-domain.example.com

# Optional comma separated list of allowed origins for the mini app API
ALLOWED_ORIGINS=

# Optional time zone for default formatting
TIME_ZONE=Europe/Moscow
